PORT=3000
ADMIN_TOKEN=change-me-to-a-long-random-string
CHAT_ENABLED=1
# VIC (vehicle-info-main) options for local/dev
# Real vehicle-info provider endpoint (leave unset to record vehicle_not_found)
VIC_UPSTREAM_URL=
VIC_UPSTREAM_TOKEN=
# Persist submissions across redeploys (mount a Railway volume at /data)
DATA_FILE=/data/data.json
# Where to persist JSON db (Railway: use a volume mount)
DATA_FILE=./data.json
